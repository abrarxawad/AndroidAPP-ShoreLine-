<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Expandable Card for Offline Rescue Guide -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGuide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/surface_card_border"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivGuideIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_lifejacket"
                app:tint="@color/primary_maritime" />

            <TextView
                android:id="@+id/tvGuideCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="WATER SURVIVAL"
                android:textColor="@color/secondary_safety_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExpandIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Expand"
                android:textColor="@color/primary_maritime"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- English Title -->
        <TextView
            android:id="@+id/tvGuideTitleEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            tools:text="Lifejacket &amp; Buoyancy Fitting" />

        <!-- Bangla Title -->
        <TextView
            android:id="@+id/tvGuideTitleBn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/primary_maritime"
            android:textStyle="bold"
            tools:text="লাইফ জ্যাকেট সঠিক নিয়মে পরিধান" />

        <!-- Summary -->
        <TextView
            android:id="@+id/tvGuideSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="How to properly fit, buckle, and secure an emergency lifejacket in under 60 seconds." />

        <!-- Expandable Steps Container (Toggled on click) -->
        <LinearLayout
            android:id="@+id/layoutExpandedSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Action Protocol &amp; Checkpoints:"
                android:textColor="@color/primary_maritime"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="1. Locate lifejacket\n2. Fasten buckles" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

