<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Vessel Check Screen (<include> toolbar, SearchView, RecyclerView, Empty State) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_canvas">

    <!-- SYLLABUS: Reusable Component (<include> Toolbar) -->
    <include
        android:id="@+id/includedToolbar"
        layout="@layout/layout_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search & QR Scan Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchControl"
        style="@style/Widget.ShoreLine.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/includedToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/vessel_search_title"
                android:textColor="@color/primary_maritime"
                android:textSize="@dimen/text_subheading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vessel_search_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <!-- Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_vessel_number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVesselSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:minHeight="@dimen/min_touch_target" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Search Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchVessel"
                    style="@style/Widget.ShoreLine.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:text="@string/action_search" />
            </LinearLayout>

            <!-- QR Code Scan Button -->
            <!-- SYLLABUS: Barcode / QR Scanner Trigger using Activity Result API -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                style="@style/Widget.ShoreLine.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/btn_scan_vessel_qr" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Subheading -->
    <TextView
        android:id="@+id/tvDirectoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:fontFamily="sans-serif-bold"
        android:text="@string/vessel_directory_header"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardSearchControl" />

    <!-- SYLLABUS: RecyclerView with Custom Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVessels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_micro"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDirectoryTitle"
        tools:listitem="@layout/item_vessel" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDirectoryTitle"
        tools:visibility="visible">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.5"
            android:src="@drawable/ic_shoreline_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:fontFamily="sans-serif-bold"
            android:text="@string/empty_no_vessels"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_subheading" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/empty_no_vessels_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressVesselLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/secondary_safety_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardSearchControl" />

</androidx.constraintlayout.widget.ConstraintLayout>
