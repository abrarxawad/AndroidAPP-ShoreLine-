<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Overload Report Submission (ScrollView, TextInputLayout, RadioGroup, MaterialCards) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_canvas"
    android:orientation="vertical">

    <!-- Reusable Toolbar via <include> -->
    <include
        android:id="@+id/includedToolbar"
        layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Offline Queue Advisory Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfflineNotice"
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/status_flagged_bg"
                app:strokeColor="@color/secondary_safety_orange">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/offline_queue_banner"
                        android:textColor="@color/text_primary_navy"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1: Target Launch Registration -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/report_vessel_label"
                        android:textColor="@color/primary_maritime"
                        android:textSize="@dimen/text_subheading" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReportVesselNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_vessel_number"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/text_primary_navy" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Quick Pre-fill Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/chipParabat"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Parabat-12"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/chipSundarban"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Sundarban-10"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/chipPubali"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Pubali-7 (Flagged)"
                            android:textColor="@color/status_danger_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Overcrowding Severity & Passenger Count -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/report_crowd_header"
                        android:textColor="@color/primary_maritime"
                        android:textSize="@dimen/text_subheading" />

                    <RadioGroup
                        android:id="@+id/rgCrowdLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small">

                        <RadioButton
                            android:id="@+id/rbCrowdNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/crowd_normal"
                            android:textColor="@color/status_safe_text" />

                        <RadioButton
                            android:id="@+id/rbCrowdModerate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/crowd_moderate"
                            android:textColor="@color/secondary_variant_amber" />

                        <RadioButton
                            android:id="@+id/rbCrowdCritical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/crowd_critical"
                            android:textColor="@color/status_danger_text"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassengerCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_estimated_passengers"
                            android:inputType="number"
                            android:text="1150"
                            android:textColor="@color/text_primary_navy" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: GPS Geotag Location (Fused Location Provider) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/gps_header"
                        android:textColor="@color/primary_maritime"
                        android:textSize="@dimen/text_subheading" />

                    <TextView
                        android:id="@+id/tvGpsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/gps_fetching"
                        android:textColor="@color/text_primary_navy"
                        android:textSize="@dimen/text_body_secondary" />

                    <Button
                        android:id="@+id/btnRefreshGps"
                        style="@style/Widget.ShoreLine.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/btn_refresh_gps"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Photo Evidence Capture & Compression -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/photo_header"
                        android:textColor="@color/primary_maritime"
                        android:textSize="@dimen/text_subheading" />

                    <ImageView
                        android:id="@+id/ivReportPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="@color/bg_light_canvas"
                        android:contentDescription="Launch deck photo preview"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_shoreline_logo" />

                    <TextView
                        android:id="@+id/tvPhotoSizeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/text_secondary_muted"
                        android:textSize="12sp"
                        tools:text="Compressed: 142 KB (Ready for 2G River Network)" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTakePhoto"
                            style="@style/Widget.ShoreLine.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_take_photo"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnSelectGallery"
                            style="@style/Widget.ShoreLine.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:text="Gallery"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Privacy Option -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ShoreLine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_anonymous_report"
                        android:textColor="@color/text_primary_navy"
                        android:textSize="@dimen/text_body_secondary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAnonymous"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit Button & Progress Bar -->
            <ProgressBar
                android:id="@+id/progressSubmitting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSubmitReport"
                style="@style/Widget.ShoreLine.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_submit_report" />

            <Button
                android:id="@+id/btnViewHistory"
                style="@style/Widget.ShoreLine.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/btn_view_history" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
