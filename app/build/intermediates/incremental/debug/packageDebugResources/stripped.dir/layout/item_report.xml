<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView Item Layout - Overload Report Card with Status Badges -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReportItem"
    style="@style/Widget.ShoreLine.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_small"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginBottom="@dimen/spacing_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Top Header: Vessel Reg & Sync Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReportVesselNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_primary_navy"
                    android:textSize="@dimen/text_subheading"
                    tools:text="MV Parabat-12 (M-01-2489)" />

                <TextView
                    android:id="@+id/tvReportTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary_muted"
                    android:textSize="@dimen/text_caption"
                    tools:text="2026-10-20 21:30 | GPS: 23.7045° N, 90.4131° E" />
            </LinearLayout>

            <!-- Sync Status Badge -->
            <TextView
                android:id="@+id/tvReportSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_safe"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="4dp"
                android:textColor="@color/status_safe_text"
                android:textSize="11sp"
                tools:text="SYNCED TO BIWTA" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@color/surface_card_border" />

        <!-- Middle Body: Photo Thumbnail + Overload Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivReportThumbnail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@color/bg_light_canvas"
                android:contentDescription="Report deck photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_shoreline_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Crowd Level Badge -->
                <TextView
                    android:id="@+id/tvReportCrowdLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/status_danger_text"
                    android:textSize="@dimen/text_body_primary"
                    tools:text="CRITICAL OVERLOAD" />

                <TextView
                    android:id="@+id/tvReportPassengerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary_navy"
                    android:textSize="@dimen/text_body_secondary"
                    tools:text="Estimated: ~1,200 Passengers on Deck" />

                <TextView
                    android:id="@+id/tvReportAnonymous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary_muted"
                    android:textSize="11sp"
                    tools:text="🔒 Submitted Anonymously" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
