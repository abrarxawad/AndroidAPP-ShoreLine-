<?xml version="1.0" encoding="utf-8"?>
<!-- STAGE 8: Offline River Rescue Guides, ContentProvider & Receivers Lab -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Banner Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/primary_variant_navy"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/coastal_cyan">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lifejacket"
                            app:tint="@color/secondary_safety_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Offline River Rescue &amp; Safety"
                            android:textColor="@color/surface_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_safe"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="CONTENT PROVIDER"
                            android:textColor="@color/primary_maritime"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="All survival manuals, CPR protocols, and rescue direct-dialers work without cellular towers or internet via ShoreLineContentProvider."
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Tabs / Section Selector -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabGuides"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="🦺 Survival Guides" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabContacts"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Rescue Directory" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabLab"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔬 Provider &amp; Receivers Lab" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- SECTION 1: SURVIVAL GUIDES -->
            <LinearLayout
                android:id="@+id/layoutSectionGuides"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:text="Offline Water Survival Manual (নদীপথে উদ্ধার নির্দেশিকা)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="2dp"
                    android:text="Tap any guide to expand action checkpoints and instructions."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRescueGuides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_rescue_guide" />
            </LinearLayout>

            <!-- SECTION 2: EMERGENCY DIRECTORY -->
            <LinearLayout
                android:id="@+id/layoutSectionContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="River Emergency Directory"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCustomContact"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:text="+ Add Contact"
                        android:textColor="@color/primary_maritime"
                        android:textSize="11sp"
                        app:strokeColor="@color/primary_maritime" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="2dp"
                    android:text="Populated via ContentResolver.query(emergency_contacts). Supports insert() operations."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEmergencyContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_emergency_contact" />
            </LinearLayout>

            <!-- SECTION 3: SYLLABUS LAB (PROVIDER & RECEIVERS) -->
            <LinearLayout
                android:id="@+id/layoutSectionLab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ContentProvider Live Query Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.2dp"
                    app:strokeColor="@color/surface_card_border"
                    app:cardBackgroundColor="@color/surface_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📦 ContentProvider Live Inspector"
                            android:textColor="@color/primary_maritime"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Executes raw ContentResolver queries against ShoreLineContentProvider and displays the active Cursor metadata."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Query Triggers -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnQueryContactsUri"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:minHeight="44dp"
                                android:backgroundTint="@color/primary_maritime"
                                android:text="Query Contacts"
                                android:textColor="@color/surface_white"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnQueryGuidesUri"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:minHeight="44dp"
                                android:backgroundTint="@color/coastal_cyan"
                                android:text="Query Guides"
                                android:textColor="@color/surface_white"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- ADB Command Box -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Terminal ADB command for viva demonstration:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvAdbCommand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_terminal_window"
                            android:fontFamily="monospace"
                            android:padding="10dp"
                            android:text="adb shell content query --uri content://com.shoreline.app.provider/emergency_contacts"
                            android:textColor="#00E676"
                            android:textSize="11sp" />

                        <!-- Diagnostic Console Output -->
                        <TextView
                            android:id="@+id/tvProviderConsole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#0A192F"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:text="[Ready] Tap a query button to test ContentResolver."
                            android:textColor="#64FFDA"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BroadcastReceivers Simulation Center -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.2dp"
                    app:strokeColor="@color/surface_card_border"
                    app:cardBackgroundColor="@color/surface_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📡 BroadcastReceivers Evaluator Lab"
                            android:textColor="@color/primary_maritime"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Trigger system broadcasts to test Boot, Battery, and Network receivers on a single test device without rebooting or draining battery."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Button 1: Boot Receiver -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateBoot"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:minHeight="46dp"
                            android:text="⚡ 1. Simulate Boot Completed (BootReceiver)"
                            android:textColor="@color/primary_maritime"
                            android:textSize="12sp"
                            app:strokeColor="@color/primary_maritime" />

                        <!-- Button 2: Battery Low Receiver -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateBatteryLow"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:minHeight="46dp"
                            android:text="⚡ 2. Simulate Battery Low &lt;15% (BatteryStateReceiver)"
                            android:textColor="@color/secondary_safety_orange"
                            android:textSize="12sp"
                            app:strokeColor="@color/secondary_safety_orange" />

                        <!-- Button 3: Connectivity Receiver -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateNetworkRestore"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:minHeight="46dp"
                            android:text="⚡ 3. Simulate Network Restore (ConnectivityReceiver)"
                            android:textColor="@color/coastal_cyan"
                            android:textSize="12sp"
                            app:strokeColor="@color/coastal_cyan" />

                        <!-- Receiver Log Console -->
                        <TextView
                            android:id="@+id/tvReceiverLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#0A192F"
                            android:fontFamily="monospace"
                            android:padding="12dp"
                            android:text="[Receivers Ready] Tap any test button above to verify receiver callback execution."
                            android:textColor="#E0E0E0"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

