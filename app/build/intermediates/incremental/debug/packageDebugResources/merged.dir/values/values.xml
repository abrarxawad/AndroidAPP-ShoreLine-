        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
    </style>
    <style name="Widget.ShoreLine.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="backgroundTint">@color/primary_maritime</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textStyle">bold</item>
