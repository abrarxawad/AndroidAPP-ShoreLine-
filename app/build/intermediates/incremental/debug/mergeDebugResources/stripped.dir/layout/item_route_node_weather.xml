<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView Item Layout - Intermediate Route Waypoint Weather -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ShoreLine.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_small">

        <!-- Top Row: Node Index, Name & Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNodeStepIndex"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_chip_safe"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:textColor="@color/status_safe_text"
                android:textSize="11sp"
                tools:text="2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNodeGhatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_primary_navy"
                    android:textSize="14sp"
                    tools:text="Chandpur Launch Terminal" />

                <TextView
                    android:id="@+id/tvNodeRiverDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary_muted"
                    android:textSize="11sp"
                    tools:text="Meghna River • Crossing +1 hr 45 min" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNodeRiskBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_safe"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/status_safe_text"
                android:textSize="10sp"
                tools:text="✓ LOW" />
        </LinearLayout>

        <!-- Worst Point on Route Marker Tag (Visible only on the highest hazard node) -->
        <TextView
            android:id="@+id/tvWorstPointTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip_flagged"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="2dp"
            android:text="⚠️ WORST HAZARD POINT ON ROUTE (সর্বোচ্চ সতর্ক সংকেত পয়েন্ট)"
            android:textColor="@color/status_danger_text"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Weather Metrics Row -->
        <TextView
            android:id="@+id/tvNodeWeatherMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary_navy"
            android:textSize="12sp"
            tools:text="29.0°C • Wind: 24 km/h (Gusts: 36 km/h) • Rain: 0.0 mm/h" />

        <!-- Condition Description -->
        <TextView
            android:id="@+id/tvNodeCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary_muted"
            android:textSize="11sp"
            tools:text="Moderate chop; navigate inland channel (হুঁশিয়ারি সংকেত ২)" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
