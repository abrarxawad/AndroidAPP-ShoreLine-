<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - ScrollView, LinearLayout, MaterialCardView, ConstraintLayout, Accessibility -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/labScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- =============================================================== -->
        <!-- HEADER CARD: Screen Information & Intent Extra Display          -->
        <!-- =============================================================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ShoreLine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvLabTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/title_lifecycle_lab"
                    android:textColor="@color/primary_maritime"
                    android:textSize="@dimen/text_heading" />

                <TextView
                    android:id="@+id/tvLabSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_micro"
                    android:text="@string/lab_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_secondary" />

                <!-- SYLLABUS: Displaying data received from Intent Extras -->
                <TextView
                    android:id="@+id/tvLaunchMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@color/chip_bg"
                    android:fontFamily="monospace"
                    android:padding="@dimen/spacing_small"
                    android:textColor="@color/primary_variant_navy"
                    android:textSize="@dimen/text_caption"
                    tools:text="Intent Extra: Triggered by USER_BUTTON_CLICK" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =============================================================== -->
        <!-- CARD 1: SYLLABUS - Real-Time Activity Lifecycle Console         -->
        <!-- =============================================================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ShoreLine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/lab_section_lifecycle"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_subheading" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:text="@string/lab_btn_clear_log"
                        android:textColor="@color/secondary_safety_orange" />
                </LinearLayout>

                <!-- Console Output Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@drawable/bg_terminal_window"
                    android:padding="@dimen/spacing_small">

                    <ScrollView
                        android:id="@+id/consoleScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvLifecycleLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            tools:text="[15:40:01] onCreate() -> Initializing\n[15:40:02] onStart() -> Visible\n[15:40:02] onResume() -> Interactive" />
                    </ScrollView>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =============================================================== -->
        <!-- CARD 2: SYLLABUS - State Preservation (onSaveInstanceState)    -->
        <!-- =============================================================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ShoreLine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/lab_section_state"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_subheading" />

                <!-- Rotation Counter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lab_rotation_counter_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_primary" />

                    <TextView
                        android:id="@+id/tvRotationCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/primary_maritime"
                        android:textSize="@dimen/text_title"
                        tools:text="0" />
                </LinearLayout>

                <!-- SYLLABUS: EditText with TextWatcher -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/lab_edit_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Live TextWatcher Feedback -->
                <TextView
                    android:id="@+id/tvTextWatcherFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_micro"
                    android:text="@string/lab_status_idle"
                    android:textColor="@color/coastal_cyan"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =============================================================== -->
        <!-- CARD 3: SYLLABUS - Comprehensive Event Listener Showroom        -->
        <!-- Demonstrates Lambda, Interface, and XML onClick implementations -->
        <!-- =============================================================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ShoreLine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/lab_section_listeners"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_subheading" />

                <!-- Listener 1: Lambda -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLambda"
                    style="@style/Widget.ShoreLine.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/lab_btn_lambda" />

                <!-- Listener 2: Interface -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInterface"
                    style="@style/Widget.ShoreLine.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/lab_btn_interface" />

                <!-- Listener 3: XML attribute android:onClick -->
                <!-- SYLLABUS: android:onClick links directly to onXmlButtonClick(View) in Activity -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnXmlClick"
                    style="@style/Widget.ShoreLine.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:onClick="onXmlButtonClick"
                    android:text="@string/lab_btn_xml" />

                <!-- Listener 4: Long Click Demonstration -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLongPress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/chip_bg"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/surface_card_border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvLongPressLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="@dimen/min_touch_target"
                        android:padding="@dimen/spacing_small"
                        android:text="@string/lab_long_press_card"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Listener 5: Compound Button (Switch) Listener -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lab_switch_label"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_primary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSync"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:checked="false"
                        app:thumbTint="@color/coastal_cyan"
                        app:trackTint="@color/surface_card_border" />
                </LinearLayout>

                <!-- SYLLABUS: Explicit Intent to simulate pause/stop/restart/resume -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateNav"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/lab_btn_simulate_nav"
                    android:textColor="@color/primary_maritime"
                    app:strokeColor="@color/primary_maritime" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
