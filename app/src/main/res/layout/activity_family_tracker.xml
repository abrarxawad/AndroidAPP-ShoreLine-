<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Family Journey Tracker with Foreground Telemetry & osmdroid Live Map (Navara Yacht Helm Theme) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed Full-Screen Yacht Cockpit Night Background Layer -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Yacht Helm Navigation Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_yacht_night_helm" />

    <!-- Dark Aquatic Frosted Glass Tint for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <!-- Main Foreground Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reusable Toolbar -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

        <!-- Mode Selector: Passenger Mode vs Family Viewer Mode -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:checkedButton="@id/btnTabPassenger"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabPassenger"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/tracker_tab_passenger"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabViewer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/tracker_tab_family"
                android:textColor="@color/navara_text_subtitle"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.2dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- ========================================== -->
                <!-- SECTION 1: PASSENGER MODE (MY JOURNEY)      -->
                <!-- ========================================== -->
                <LinearLayout
                    android:id="@+id/layoutPassengerMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card 1A: Voyage Setup Form (Visible when idle) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVoyageSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/tracker_setup_title"
                                android:textColor="@color/navara_text_title"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/tracker_setup_subtitle"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />

                            <!-- Origin Terminal -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/tracker_origin_label"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinnerOrigin"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_glass"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                            <!-- Destination Terminal -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/tracker_dest_label"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spinnerDestination"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_glass"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                            <!-- Live Terminal Proximity & GPS Geofence Banner -->
                            <LinearLayout
                                android:id="@+id/layoutTerminalProximity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_navara_glass_card"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:id="@+id/ivProximityStatus"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_map"
                                    app:tint="@color/status_warning_amber" />

                                <TextView
                                    android:id="@+id/tvProximityStatus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Acquiring real-time GPS location..."
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Vessel Name Label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Launch Vessel Name (লঞ্চের নাম)"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />

                            <!-- Vessel Name Input Box (Standard General Box Size) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColorHint="@color/navara_text_subtitle"
                                app:boxBackgroundColor="#1500E5FF"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusBottomEnd="16dp"
                                app:boxCornerRadiusBottomStart="16dp"
                                app:boxCornerRadiusTopEnd="16dp"
                                app:boxCornerRadiusTopStart="16dp"
                                app:boxStrokeColor="@color/navara_neon_cyan"
                                app:boxStrokeWidth="1.2dp"
                                app:hintEnabled="false">

                                <AutoCompleteTextView
                                    android:id="@+id/etVesselName"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:minHeight="52dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:hint="Type or select launch (e.g. MV Manami, MV Parabat-12)"
                                    android:textColorHint="@color/navara_text_subtitle"
                                    android:inputType="textCapWords"
                                    android:text="MV Manami"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="15sp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:completionThreshold="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Start Journey Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStartJourney"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="16dp"
                                android:backgroundTint="@color/navara_neon_cyan"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/tracker_btn_start"
                                android:textColor="#00141D"
                                android:textSize="14sp"
                                app:cornerRadius="26dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 1B: Active Voyage Dashboard (Visible when tracking) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardActiveJourney"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Share Code Display -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/tracker_code_title"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_spinner_glass"
                                android:gravity="center"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvShareCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:letterSpacing="0.25"
                                    android:textColor="@color/navara_neon_cyan"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    tools:text="PADMA7" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/tracker_code_subtitle"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="11sp" />

                            <!-- Share Actions -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopyCode"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/tracker_btn_copy"
                                    android:textColor="@color/navara_neon_cyan"
                                    android:textSize="12sp"
                                    app:cornerRadius="22dp"
                                    app:strokeColor="@color/navara_neon_cyan"
                                    app:strokeWidth="1.2dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnShareCode"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/tracker_btn_share"
                                    android:textColor="@color/navara_neon_cyan"
                                    android:textSize="12sp"
                                    app:cornerRadius="22dp"
                                    app:strokeColor="@color/navara_neon_cyan"
                                    app:strokeWidth="1.2dp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="10dp"
                                android:background="#263E46" />

                            <!-- Live Metrics Title -->
                            <TextView
                                android:id="@+id/tvPassengerRouteHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/navara_text_title"
                                android:textSize="15sp"
                                tools:text="MV Parabat 11 • Dhaka ➔ Barisal" />

                            <!-- 4 Telemetry Metrics Grid -->
                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:columnCount="2"
                                android:rowCount="2">

                                <!-- Metric 1: Speed -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="3dp"
                                    android:background="@drawable/bg_spinner_glass"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:text="@string/tracker_metric_speed"
                                        android:textColor="@color/navara_text_subtitle"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvPassengerSpeed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-black"
                                        android:textColor="#FFFFFF"
                                        android:textSize="18sp"
                                        tools:text="25.4 km/h" />
                                </LinearLayout>

                                <!-- Metric 2: Distance -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="3dp"
                                    android:background="@drawable/bg_spinner_glass"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:text="@string/tracker_metric_distance"
                                        android:textColor="@color/navara_text_subtitle"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvPassengerDistance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-black"
                                        android:textColor="#FFFFFF"
                                        android:textSize="18sp"
                                        tools:text="42.8 km" />
                                </LinearLayout>

                                <!-- Metric 3: Nearest Ghat -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="3dp"
                                    android:background="@drawable/bg_spinner_glass"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:text="@string/tracker_metric_near"
                                        android:textColor="@color/navara_text_subtitle"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvPassengerNearestGhat"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:fontFamily="sans-serif-bold"
                                        android:maxLines="1"
                                        android:textColor="@color/navara_neon_cyan"
                                        android:textSize="13sp"
                                        tools:text="Chandpur (Molhead)" />
                                </LinearLayout>

                                <!-- Metric 4: Elapsed Time -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="3dp"
                                    android:background="@drawable/bg_spinner_glass"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:text="@string/tracker_metric_time"
                                        android:textColor="@color/navara_text_subtitle"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvPassengerElapsed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-black"
                                        android:textColor="@color/navara_mint"
                                        android:textSize="18sp"
                                        tools:text="01:42:15" />
                                </LinearLayout>
                            </GridLayout>

                            <!-- Stop Journey Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStopJourney"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="16dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/tracker_btn_stop"
                                android:textColor="#FF6B6B"
                                app:cornerRadius="24dp"
                                app:strokeColor="#FF6B6B"
                                app:strokeWidth="1.2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Passenger osmdroid River Map Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPassengerMap"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <org.osmdroid.views.MapView
                                android:id="@+id/mapPassenger"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Floating Map Controls Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/bg_navara_glass_card"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="🗺️ Live River Route"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToggleMapSizePassenger"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:backgroundTint="#CC00141D"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="⛶ Bigger Map"
                                    android:textColor="@color/navara_neon_cyan"
                                    android:textSize="11sp"
                                    app:cornerRadius="18dp"
                                    app:strokeColor="@color/navara_neon_cyan"
                                    app:strokeWidth="1dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnOpenFullscreenMapPassenger"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:backgroundTint="#CC00141D"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="🌐 Full Map"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="11sp"
                                    app:cornerRadius="18dp"
                                    app:strokeColor="@color/navara_glass_border"
                                    app:strokeWidth="1dp" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ========================================== -->
                <!-- SECTION 2: FAMILY VIEWER MODE              -->
                <!-- ========================================== -->
                <LinearLayout
                    android:id="@+id/layoutViewerMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <!-- Card 2A: Search Journey Code -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/tracker_viewer_title"
                                android:textColor="@color/navara_text_title"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/tracker_viewer_subtitle"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColorHint="@color/navara_text_subtitle"
                                    app:boxBackgroundColor="#1000E5FF"
                                    app:boxBackgroundMode="outline"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxStrokeColor="@color/navara_neon_cyan"
                                    app:hintTextColor="@color/navara_neon_cyan">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etViewerCode"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="monospace"
                                        android:hint="@string/tracker_viewer_hint"
                                        android:textColorHint="@color/navara_text_subtitle"
                                        android:inputType="textCapCharacters"
                                        android:maxLength="8"
                                        android:textAllCaps="true"
                                        android:textColor="@color/navara_text_title"
                                        android:textSize="15sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSearchJourney"
                                    android:layout_width="wrap_content"
                                    android:layout_height="56dp"
                                    android:layout_marginStart="8dp"
                                    android:backgroundTint="@color/navara_neon_cyan"
                                    android:fontFamily="sans-serif-black"
                                    android:text="@string/tracker_btn_track"
                                    android:textColor="#00141D"
                                    android:textSize="13sp"
                                    app:cornerRadius="28dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2B: Family Tracking Results -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardViewerDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Status & Route Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvViewerVesselRoute"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-black"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="15sp"
                                    tools:text="MV Parabat 11 (Dhaka ➔ Barisal)" />

                                <TextView
                                    android:id="@+id/tvViewerStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_chip_safe"
                                    android:fontFamily="sans-serif-bold"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:textColor="@color/status_safe_text"
                                    android:textSize="10sp"
                                    tools:text="EN ROUTE" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvViewerPassengerInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp"
                                tools:text="Passenger: Abrar Jawad" />

                            <!-- Live Telemetry Row -->
                            <TextView
                                android:id="@+id/tvViewerTelemetry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="15sp"
                                tools:text="Speed: 25.4 km/h • Near Chandpur (Molhead)" />

                            <TextView
                                android:id="@+id/tvViewerLastUpdated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/navara_mint"
                                android:textSize="11sp"
                                tools:text="Updated 2 mins ago • GPS synced" />

                            <!-- Call Passenger Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCallPassenger"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/tracker_call_passenger"
                                android:textColor="@color/navara_neon_cyan"
                                app:cornerRadius="24dp"
                                app:strokeColor="@color/navara_neon_cyan"
                                app:strokeWidth="1.2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Viewer osmdroid River Map Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardViewerMap"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/navara_glass_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1.2dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <org.osmdroid.views.MapView
                                android:id="@+id/mapViewer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Floating Map Controls Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/bg_navara_glass_card"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="🗺️ Live Fleet Tracking"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToggleMapSizeViewer"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:backgroundTint="#CC00141D"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="⛶ Bigger Map"
                                    android:textColor="@color/navara_neon_cyan"
                                    android:textSize="11sp"
                                    app:cornerRadius="18dp"
                                    app:strokeColor="@color/navara_neon_cyan"
                                    app:strokeWidth="1dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnOpenFullscreenMapViewer"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:backgroundTint="#CC00141D"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="🌐 Full Map"
                                    android:textColor="@color/navara_text_title"
                                    android:textSize="11sp"
                                    app:cornerRadius="18dp"
                                    app:strokeColor="@color/navara_glass_border"
                                    app:strokeWidth="1dp" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
