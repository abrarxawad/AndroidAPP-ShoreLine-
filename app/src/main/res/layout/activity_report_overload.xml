<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Overload Report Submission (Navara Night Cockpit Glassmorphic Theme) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient">

    <!-- Fixed Full-Screen Background Image (Night Cockpit View with Cyan Bioluminescent Wakes) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_yacht_night_helm" />

    <!-- Ambient Scrim for High-Contrast Form Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8802181E" />

    <!-- Depth Scrim Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reusable Toolbar via <include> -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="40dp">

                <!-- Offline Queue Advisory Banner (Frosted Amber Glass) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOfflineNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/secondary_variant_amber"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/offline_queue_banner"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 1: Target Launch Registration (Frosted Glass) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/report_vessel_label"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/hint_vessel_number"
                            android:textColorHint="@color/navara_text_subtitle"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/navara_neon_cyan"
                            app:hintTextColor="@color/navara_neon_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReportVesselNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:inputType="textCapCharacters"
                                android:textColor="@color/navara_text_title" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Quick Pre-fill Chips -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipParabat"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_navara_chip"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Parabat-12"
                                android:textAllCaps="false"
                                android:textColor="@color/navara_text_title"
                                android:textSize="11sp"
                                app:backgroundTint="@null" />

                            <Button
                                android:id="@+id/chipSundarban"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_navara_chip"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Sundarban-10"
                                android:textAllCaps="false"
                                android:textColor="@color/navara_text_title"
                                android:textSize="11sp"
                                app:backgroundTint="@null" />

                            <Button
                                android:id="@+id/chipPubali"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1.2"
                                android:background="@drawable/bg_navara_chip"
                                android:fontFamily="sans-serif-bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Pubali-7 (Flagged)"
                                android:textAllCaps="false"
                                android:textColor="#FF6B6B"
                                android:textSize="10sp"
                                app:backgroundTint="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Overcrowding Severity & Passenger Count -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/report_crowd_header"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <RadioGroup
                            android:id="@+id/rgCrowdLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/rbCrowdNormal"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:buttonTint="#10B981"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/crowd_normal"
                                android:textColor="@color/navara_text_title"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbCrowdModerate"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:buttonTint="@color/secondary_variant_amber"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/crowd_moderate"
                                android:textColor="@color/navara_text_title"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbCrowdCritical"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:buttonTint="#EF4444"
                                android:checked="true"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/crowd_critical"
                                android:textColor="#FF6B6B"
                                android:textSize="13sp" />
                        </RadioGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/label_estimated_passengers"
                            android:textColorHint="@color/navara_text_subtitle"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/navara_neon_cyan"
                            app:hintTextColor="@color/navara_neon_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassengerCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:inputType="number"
                                android:text="1150"
                                android:textColor="@color/navara_text_title" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: GPS Geotag Location -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/gps_header"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvGpsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/gps_fetching"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnRefreshGps"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_navara_glass_card"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/btn_refresh_gps"
                            android:textAllCaps="false"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="12sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Photo Evidence Capture -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/photo_header"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="10dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/navara_glass_border"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/ivReportPhotoPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#152830"
                                android:contentDescription="Launch deck photo preview"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_shoreline_logo" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvPhotoSizeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp"
                            tools:text="Compressed: 142 KB (Ready for 2G River Network)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnTakePhoto"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_navara_neon_button"
                                android:fontFamily="sans-serif-black"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/btn_take_photo"
                                android:textAllCaps="false"
                                android:textColor="@color/navara_text_dark"
                                android:textSize="13sp"
                                app:backgroundTint="@null" />

                            <Button
                                android:id="@+id/btnSelectGallery"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_navara_glass_card"
                                android:fontFamily="sans-serif-bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Gallery"
                                android:textAllCaps="false"
                                android:textColor="@color/navara_text_title"
                                android:textSize="13sp"
                                app:backgroundTint="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 5: Privacy Option -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/label_anonymous_report"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAnonymous"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/navara_neon_cyan"
                            app:trackTint="#4D00C9B7" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Submit Button & Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressSubmitting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:indeterminateTint="@color/navara_neon_cyan"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitReport"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_navara_neon_button"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_submit_report"
                    android:textAllCaps="false"
                    android:textColor="@color/navara_text_dark"
                    android:textSize="15sp"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_navara_glass_card"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/btn_view_history"
                    android:textAllCaps="false"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
