<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Reusable UI Component - Shared Toolbar layout via <include> (Navara Dark Glassmorphic) -->
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appToolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="#D002181E"
    android:elevation="0dp"
    android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
    app:navigationIcon="?attr/homeAsUpIndicator"
    app:navigationIconTint="@color/navara_neon_cyan"
    app:titleTextColor="@color/navara_text_title" />
