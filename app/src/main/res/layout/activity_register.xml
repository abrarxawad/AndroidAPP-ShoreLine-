<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Registration Screen (Navara Aquatic Glassmorphic Luxury Style) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01"
            android:text="@string/title_register"
            android:textColor="@color/navara_text_title"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/register_subtitle"
            android:textColor="@color/navara_text_subtitle"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/navara_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/navara_glass_border"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_full_name"
                    android:textColorHint="@color/navara_text_subtitle"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/navara_neon_cyan"
                    app:hintTextColor="@color/navara_neon_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="textPersonName"
                        android:minHeight="@dimen/min_touch_target"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_email"
                    android:textColorHint="@color/navara_text_subtitle"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/navara_neon_cyan"
                    app:hintTextColor="@color/navara_neon_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="textEmailAddress"
                        android:minHeight="@dimen/min_touch_target"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_password"
                    android:textColorHint="@color/navara_text_subtitle"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/navara_neon_cyan"
                    app:hintTextColor="@color/navara_neon_cyan"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/navara_neon_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="textPassword"
                        android:minHeight="@dimen/min_touch_target"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Number -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_phone"
                    android:textColorHint="@color/navara_text_subtitle"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/navara_neon_cyan"
                    app:hintTextColor="@color/navara_neon_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="phone"
                        android:minHeight="@dimen/min_touch_target"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Role Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/label_role"
                    android:textColor="@color/navara_text_title"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPassenger"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:buttonTint="@color/navara_neon_cyan"
                        android:checked="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/role_passenger"
                        android:textColor="@color/navara_text_title" />

                    <RadioButton
                        android:id="@+id/rbAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target"
                        android:buttonTint="@color/navara_neon_cyan"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/role_admin"
                        android:textColor="@color/navara_text_title" />
                </RadioGroup>

                <!-- Emergency Contact Phone (Kin/Friend) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_emergency_contact"
                    android:textColorHint="@color/navara_text_subtitle"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/navara_neon_cyan"
                    app:hintTextColor="@color/navara_neon_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegEmergency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="phone"
                        android:minHeight="@dimen/min_touch_target"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/regProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/navara_neon_cyan"
                    android:visibility="gone" />

                <!-- Register Button (Glowing Turquoise Pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_navara_neon_button"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_register"
                    android:textAllCaps="false"
                    android:textColor="@color/navara_text_dark"
                    android:textSize="15sp"
                    app:backgroundTint="@null" />

                <!-- Back to Login -->
                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="@dimen/min_touch_target"
                    android:padding="8dp"
                    android:text="@string/prompt_has_account"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
