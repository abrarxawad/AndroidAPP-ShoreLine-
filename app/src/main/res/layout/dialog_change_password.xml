<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog layout for updating user account password (Navara Dark Yacht Glass Theme) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_navara_glass_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/settings_btn_change_password"
        android:textColor="@color/navara_text_title"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="@string/settings_new_password"
        android:textColor="@color/navara_text_subtitle"
        android:textSize="12sp" />

    <!-- Current Password -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/settings_current_password"
        android:textColorHint="@color/navara_text_subtitle"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/navara_neon_cyan">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textPassword"
            android:textColor="@color/navara_text_title"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- New Password -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/settings_new_password"
        android:textColorHint="@color/navara_text_subtitle"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/navara_neon_cyan">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textPassword"
            android:textColor="@color/navara_text_title"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Password -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/settings_confirm_password"
        android:textColorHint="@color/navara_text_subtitle"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/navara_neon_cyan">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textPassword"
            android:textColor="@color/navara_text_title"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancelPassword"
            style="@style/Widget.ShoreLine.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmitPassword"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_navara_neon_button"
            android:fontFamily="sans-serif-black"
            android:text="@string/settings_btn_change_password"
            android:textAllCaps="false"
            android:textColor="@color/navara_text_dark"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>

