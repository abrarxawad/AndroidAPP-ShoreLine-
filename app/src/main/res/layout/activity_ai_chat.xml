<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00141D"
    android:orientation="vertical">

    <!-- Top Navigation Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#001B27"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_navara_chip">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🤖"
                    android:textSize="18sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="ShoreLine AI Copilot"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAiStatusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="🟢 Online • Maritime Safety Assistant"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- API Key Configuration Icon -->
            <ImageView
                android:id="@+id/btnApiKeySettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_navara_glass_card"
                android:clickable="true"
                android:contentDescription="API Key Settings"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/navara_neon_cyan" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Quick Issue Suggestion Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#051822"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipOverload"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1500E5FF"
                android:fontFamily="sans-serif-bold"
                android:text="🚨 Launch is Overcrowded"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipWeather"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1500E5FF"
                android:fontFamily="sans-serif-bold"
                android:text="🌧️ Storm &amp; Safe Route"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipTracking"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1500E5FF"
                android:fontFamily="sans-serif-bold"
                android:text="📍 Track My Launch"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipEmergency"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#20EF4444"
                android:fontFamily="sans-serif-bold"
                android:text="🆘 Sinking / Fire Distress"
                android:textColor="#F87171"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="#EF4444"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipVessel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1500E5FF"
                android:fontFamily="sans-serif-bold"
                android:text="🚢 Vessel Fitness Check"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Thinking / Progress Indicator -->
    <LinearLayout
        android:id="@+id/layoutTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_navara_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/navara_neon_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="AI Copilot is analyzing..."
            android:textColor="@color/navara_neon_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#001B27"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner_glass"
            android:fontFamily="sans-serif"
            android:hint="Ask anything or report an issue..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendMessage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/navara_neon_cyan"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="➤"
            android:textColor="#00141D"
            android:textSize="16sp"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>

