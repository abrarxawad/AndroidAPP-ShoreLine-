<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Expandable Card for Offline Rescue Guide (Navara Dark Glassmorphic Theme) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGuide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/navara_glass_border"
    app:cardBackgroundColor="@color/navara_glass_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivGuideIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_lifejacket"
                app:tint="@color/navara_neon_cyan" />

            <TextView
                android:id="@+id/tvGuideCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/guide_badge_water_survival"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvExpandIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_expand"
                android:textColor="@color/navara_mint"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <!-- English Title -->
        <TextView
            android:id="@+id/tvGuideTitleEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/navara_text_title"
            tools:text="Lifejacket &amp; Buoyancy Fitting" />

        <!-- Bangla Title -->
        <TextView
            android:id="@+id/tvGuideTitleBn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/navara_neon_cyan"
            android:fontFamily="sans-serif-medium"
            tools:text="লাইফ জ্যাকেট সঠিক নিয়মে পরিধান" />

        <!-- Summary -->
        <TextView
            android:id="@+id/tvGuideSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/navara_text_subtitle"
            tools:text="How to properly fit, buckle, and secure an emergency lifejacket in under 60 seconds." />

        <!-- Expandable Steps Container (Toggled on click) -->
        <LinearLayout
            android:id="@+id/layoutExpandedSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_navara_glass_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_action_protocol"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tvStepsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/navara_text_title"
                android:textSize="12sp"
                tools:text="1. Locate lifejacket\n2. Fasten buckles" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
