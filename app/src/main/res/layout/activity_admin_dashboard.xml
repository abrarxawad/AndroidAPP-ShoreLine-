<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Stage 7 - Port Authority & BIWTA Inspector Admin Dashboard (Navara Yacht Deck Theme) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient">

    <!-- Background Deck Yacht Hero View -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_deck_yacht_view" />

    <!-- Dark Aquatic Tint for Maximum Readability of Admin Controls -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B802181E" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- BMD Warning Broadcast Banner Card (Glassmorphic) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStormBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/secondary_variant_amber"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivStormBannerIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_storm"
                            app:tint="@color/secondary_variant_amber" />

                        <TextView
                            android:id="@+id/tvStormBannerTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="BMD Storm Signal Advisory"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvActiveSignalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_warning"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="Signal 3"
                            android:textColor="@color/status_warning_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStormBannerBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:text="Cautionary signal in effect for Padma-Meghna confluence. Trawlers must navigate near shorelines."
                        android:textColor="@color/navara_text_subtitle"
                        android:textSize="12sp" />

                    <!-- Broadcast Signal Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBroadcastStormSignal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_navara_neon_button"
                        android:fontFamily="sans-serif-bold"
                        android:minHeight="48dp"
                        android:text="📢 Broadcast BMD Storm Warning (FCM Alert)"
                        android:textAllCaps="false"
                        android:textColor="@color/navara_text_dark"
                        android:textSize="13sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Command Center Section Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="PORT AUTHORITY COMMAND OVERVIEW"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="13sp" />

            <!-- SYLLABUS: GridLayoutManager Section (2 Columns) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminStatTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_admin_stat_tile"
                tools:spanCount="2" />

            <!-- Fast Action Buttons (Map Hotspots & Test Simulator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenHotspotsMap"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_navara_glass_card"
                    android:fontFamily="sans-serif-bold"
                    android:text="🗺️ Hotspots Map"
                    android:textAllCaps="false"
                    android:textColor="@color/navara_text_title"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateIncident"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_navara_glass_card"
                    android:fontFamily="sans-serif-bold"
                    android:text="⚡ Simulate Alert"
                    android:textAllCaps="false"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Incident Inbox Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:text="SOS DISTRESS &amp; INCIDENTS"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvIncidentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_navara_chip"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="0 Incidents"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Filter Chips (All, Active, Acknowledged, Resolved) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All Incidents"
                        android:textColor="@color/navara_text_title" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterActive"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Active (Unresolved)"
                        android:textColor="@color/navara_text_title" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAcknowledged"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏳ Acknowledged"
                        android:textColor="@color/navara_text_title" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterResolved"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Resolved"
                        android:textColor="@color/navara_text_title" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyIncidents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="No distress incidents reported in this category."
                android:textColor="@color/navara_text_subtitle"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- SYLLABUS: RecyclerView 4 (SOS Inbox with ItemTouchHelper swipe gestures) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIncidentInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_admin_incident" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
