<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Vessel Detail Screen with Custom CapacityGaugeView (Yacht Night Cockpit Glass Theme) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient">

    <!-- Fixed Full-Screen Background Image (Night Cockpit View with Cyan Bioluminescent Wakes) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_yacht_night_helm" />

    <!-- Ambient Scrim for Contrast & Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8802181E" />

    <!-- Depth Scrim Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Vessel Header Card (Navara Frosted Glass) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvDetailVesselName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/navara_text_title"
                            android:textSize="22sp"
                            tools:text="MV Parabat-12" />

                        <TextView
                            android:id="@+id/tvDetailRegNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="13sp"
                            tools:text="BIWTA Registration: M-01-2489" />

                        <TextView
                            android:id="@+id/tvDetailRoute"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="14sp"
                            tools:text="Route: Dhaka (Sadarghat) - Barisal" />

                        <!-- Overload Flag Banner (If flagged) -->
                        <TextView
                            android:id="@+id/tvFlaggedAlert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_terminal_window"
                            android:fontFamily="sans-serif-bold"
                            android:padding="10dp"
                            android:text="@string/vessel_warning_overcrowd"
                            android:textColor="@color/status_danger_red"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Custom Gauge Card (Navara Frosted Glass) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/gauge_section_title"
                            android:textColor="@color/navara_text_title"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/gauge_interactive_hint"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />

                        <!-- Custom Gauge Widget -->
                        <com.shoreline.app.ui.view.CapacityGaugeView
                            android:id="@+id/capacityGauge"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="8dp"
                            app:gaugeStrokeWidth="26dp"
                            app:licensedCapacity="950"
                            app:currentLoad="540" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="@string/vessel_gauge_drag_hint"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BIWTA Official Credentials Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/vessel_specs_header"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="16sp" />

                        <!-- Spec 1: Licensed Capacity -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_licensed_capacity"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailCapacity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/navara_text_title"
                                android:textSize="14sp"
                                tools:text="950 Persons" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/navara_glass_border" />

                        <!-- Spec 2: Fitness Expiry (Clean vertical stack so it NEVER overlaps) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_fitness_expiry"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailFitness"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/status_safe_text"
                                android:textSize="14sp"
                                tools:text="31 Dec 2027 (VALID)" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/navara_glass_border" />

                        <!-- Spec 3: Community Safety Rating -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_community_rating"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="#FFD54F"
                                android:textSize="14sp"
                                tools:text="★ 4.6 / 5.0 (14 Reports)" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Report Overcrowding Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportThisVessel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_navara_danger_button"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/btn_report_overload_action"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
