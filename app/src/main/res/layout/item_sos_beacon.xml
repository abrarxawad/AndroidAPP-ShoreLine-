<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView Item Layout - Received Distress Beacon in Mesh (Navara Glassmorphic Theme) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/navara_glass_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#80FF3B30"
    app:strokeWidth="1.4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Vessel Name & Hop Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBeaconVessel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="#FF6B6B"
                android:textSize="15sp"
                tools:text="🚨 MV Karnaphuli 4" />

            <TextView
                android:id="@+id/tvBeaconHopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_flagged"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="#FF6B6B"
                android:textSize="10sp"
                tools:text="HOP 1 OF 3 (MESH)" />
        </LinearLayout>

        <!-- Sender & Emergency Type -->
        <TextView
            android:id="@+id/tvBeaconSenderInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/navara_text_title"
            android:textSize="13sp"
            tools:text="Passenger: Rahim Uddin (01712345678)" />

        <TextView
            android:id="@+id/tvBeaconCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/navara_text_subtitle"
            android:textSize="11sp"
            tools:text="GPS: 23.2321° N, 90.6473° E • Received 2 mins ago" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallSender"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/sos_call_vessel"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenLocation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/sos_open_map"
                android:textColor="@color/navara_mint"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/navara_mint"
                app:strokeWidth="1.2dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
