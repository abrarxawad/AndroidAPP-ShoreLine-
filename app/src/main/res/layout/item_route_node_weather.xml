<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView Item Layout - Intermediate Route Waypoint Weather (Navara Glassmorphic Theme) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/navara_glass_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/navara_glass_border"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: Node Index, Name & Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNodeStepIndex"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_chip_safe"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/status_safe_text"
                android:textSize="11sp"
                tools:text="2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNodeGhatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/navara_text_title"
                    android:textSize="14sp"
                    tools:text="Chandpur Launch Terminal" />

                <TextView
                    android:id="@+id/tvNodeRiverDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="11sp"
                    tools:text="Meghna River • Crossing +1 hr 45 min" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNodeRiskBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_safe"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/status_safe_text"
                android:textSize="10sp"
                tools:text="✓ LOW" />
        </LinearLayout>

        <!-- Worst Point on Route Marker Tag (Visible only on the highest hazard node) -->
        <TextView
            android:id="@+id/tvWorstPointTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_flagged"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/worst_hazard_point_badge"
            android:textColor="#FF6B6B"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Weather Condition & Metrics Row -->
        <TextView
            android:id="@+id/tvNodeCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/navara_text_title"
            android:textSize="12sp"
            tools:text="Mainly Clear" />

        <TextView
            android:id="@+id/tvNodeWeatherMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/navara_neon_cyan"
            android:textSize="11sp"
            tools:text="29.0°C • 💨 Wind: 22 km/h • 🌧️ Rain: 0.0 mm/h" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
