<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Navara Luxury Dark Aquatic Glassmorphic Dashboard with Fixed Fullscreen Maritime Background -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient">

    <!-- ============================================================= -->
    <!-- FIXED FULLSCREEN BACKGROUND IMAGE (Visible Throughout Scroll)  -->
    <!-- ============================================================= -->
    <ImageView
        android:id="@+id/ivHomeHeroBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Marine Hero Backdrop"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_yacht_night_helm" />

    <!-- Ambient Scrim Tint for High Contrast Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8802181E" />

    <!-- Seamless Scrim Fade for Depth & Visual Richness -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <!-- ============================================================= -->
    <!-- SCROLLABLE OPTIONS & FROSTED GLASS CARDS (Blended over image) -->
    <!-- ============================================================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <!-- 1. TOP APP BAR (User Profile & Welcome + Settings Action) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left Profile & Welcome Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_navara_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <!-- Avatar Circle with Glowing Teal Border -->
                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_navara_chip">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="👤"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <!-- Welcome Text, Full Name & Role Badge -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/welcome_aboard"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:textColor="@color/navara_text_title"
                            android:textSize="16sp"
                            tools:text="Ahnaf Jawad" />

                        <!-- Role Badge and User Email -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRoleBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_navara_chip"
                                android:fontFamily="sans-serif-black"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="9sp"
                                tools:text="PASSENGER" />

                            <TextView
                                android:id="@+id/tvUserEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:maxLines="1"
                                android:textColor="@color/navara_text_muted"
                                android:textSize="11sp"
                                tools:text="ahnafxawad@gmail.com" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Settings Action Button on the Right -->
                <ImageView
                    android:id="@+id/btnOpenSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_navara_glass_card"
                    android:clickable="true"
                    android:contentDescription="@string/nav_settings"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/navara_neon_cyan" />

            </LinearLayout>

            <!-- Live Network Sync Status Floating Pill -->
            <LinearLayout
                android:id="@+id/layoutNetworkStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_navara_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/viewNetworkStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_online" />

                <TextView
                    android:id="@+id/tvNetworkStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/status_cloud_synced"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2. MAIN TITLE (Aurelia AX Ascend Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="@string/shoreline_maritime"
                    android:textColor="@color/navara_text_title"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_navara_chip"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="BD-78"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/active_river_fleet"
                android:textColor="@color/navara_text_subtitle"
                android:textSize="13sp" />

            <!-- ============================================================= -->
            <!-- 3. CENTER HERO 3D YACHT CARD (Exact Navara Screen 2 Style)     -->
            <!-- ============================================================= -->
            <!-- 3. FLOATING HERO VESSEL CARD (Frosted Glassmorphism Theme)     -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Launch Image Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/cardVesselImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Bangladesh River Launch Fleet"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_bd_launch_terminal" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Details Row: Name + Location + Rate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="MV Manami (মানামী)"
                                android:textColor="@color/navara_text_title"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="📍 Barishal Launch Ghat ➔ Dhaka Sadarghat"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_passenger_load"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="45% Safe"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Specification Chips Row (Navara 3-pill frosted glass style) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="⚓ 2,400 HP"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="🛟 850 Buoys"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="📡 AIS Radar"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Glowing Turquoise Action Pill Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickStartVoyage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_navara_neon_button"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="@string/home_launch_safe_journey"
                        android:textAllCaps="false"
                        android:textColor="@color/navara_text_dark"
                        android:textSize="14sp"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- 4. FLOATING ADVISORY CARD (Navara Frosted Glass Alert)         -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/home_alert_sample"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnAlertDismiss"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="@string/home_dismiss"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnAlertAction"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_neon_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="@string/home_view_safe_route"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- AI MARITIME COPILOT & CHATBOT CARD                            -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiCopilot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A00E5FF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_navara_chip">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🤖"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="ShoreLine AI Copilot"
                                android:textColor="@color/navara_text_title"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_navara_chip"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="6dp"
                                android:paddingTop="1dp"
                                android:paddingEnd="6dp"
                                android:paddingBottom="1dp"
                                android:text="24/7 AI"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="Ask anything about launch overcrowding, weather, or emergencies"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="➔"
                        android:textColor="@color/navara_neon_cyan"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- 5. SECTION TITLE: RIVER TRANSIT SERVICES                      -->
            <!-- ============================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01"
                android:text="@string/home_river_transit_services"
                android:textColor="@color/navara_text_title"
                android:textSize="18sp" />

            <!-- ============================================================= -->
            <!-- 6. 2-COLUMN BENTO GRID OF DARK GLASS CARDS                    -->
            <!-- ============================================================= -->
            <!-- Row 1: Vessel Check & Safe Route -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: Vessel Check -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVesselCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🚢"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_vessel_check"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_vessel_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Safe Route -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafeRoute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🗺️"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_safe_route"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_route_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Family Tracker & Overload Report -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 3: Family Tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFamilyTracker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="📍"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_family_tracker"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_tracker_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Overload Report -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOverloadReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="⚠️"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_overload_report"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_report_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 3: Offline SOS Beacon & Emergency Guides -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 5: Offline SOS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOfflineSos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#80EF4444"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🚨"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_offline_sos"
                            android:textColor="#F87171"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_sos_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 6: Safety Guides -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafetyGuides"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🛟"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_safety_guides"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_guide_desc"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 4: Port Authority Dashboard Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#CC071B20"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_navara_chip"
                        android:gravity="center"
                        android:text="🛡️"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/home_admin_card_title"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_admin_card_desc"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="➔"
                        android:textColor="@color/navara_neon_cyan"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. Academic Syllabus Diagnostics Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenLifecycleLab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/home_lifecycle_lab"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="12sp"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
