<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Navara Luxury Dark Aquatic Glassmorphic Dashboard with Fixed Fullscreen Maritime Background -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navara_gradient">

    <!-- ============================================================= -->
    <!-- FIXED FULLSCREEN BACKGROUND IMAGE (Visible Throughout Scroll)  -->
    <!-- ============================================================= -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Marine Hero Backdrop"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_deck_yacht_view" />

    <!-- Ambient Scrim Tint for High Contrast Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8802181E" />

    <!-- Seamless Scrim Fade for Depth & Visual Richness -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <!-- ============================================================= -->
    <!-- SCROLLABLE OPTIONS & FROSTED GLASS CARDS (Blended over image) -->
    <!-- ============================================================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <!-- 1. TOP APP BAR (Noah James / User Profile Pill + Glass Menu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left Profile Pill -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_navara_glass_card"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_navara_chip"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome aboard"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:textColor="@color/navara_text_title"
                            android:textSize="12sp"
                            tools:text="Abrar Jawad" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Admin Portal Button (Navara Glass Pill) -->
                <TextView
                    android:id="@+id/btnQuickAdminPortal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_navara_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🛡️ Pass"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="12sp" />

                <!-- Logout Button (Explicit, high-contrast, fully visible) -->
                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_navara_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚪"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Logout"
                        android:textColor="#FF6B6B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subtitle Badges (Email & Role) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_navara_chip"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="10sp"
                    tools:text="PASSENGER" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/navara_text_muted"
                    android:textSize="11sp"
                    tools:text="passenger@shoreline.bd" />
            </LinearLayout>

            <!-- 2. MAIN TITLE (Aurelia AX Ascend Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="ShoreLine Maritime"
                    android:textColor="@color/navara_text_title"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_navara_chip"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="BD-78"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Active River Fleet &amp; Passenger Safety Network"
                android:textColor="@color/navara_text_subtitle"
                android:textSize="13sp" />

            <!-- ============================================================= -->
            <!-- 3. CENTER HERO 3D YACHT CARD (Exact Navara Screen 2 Style)     -->
            <!-- ============================================================= -->
            <!-- 3. FLOATING HERO VESSEL CARD (Frosted Glassmorphism Theme)     -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Launch Image Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/navara_glass_border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/cardVesselImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Bangladesh River Launch Fleet"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_bd_launch_terminal" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Details Row: Name + Location + Rate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="MV Manami (মানামী)"
                                android:textColor="@color/navara_text_title"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="📍 Barishal Launch Ghat ➔ Dhaka Sadarghat"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="passenger load"
                                android:textColor="@color/navara_text_subtitle"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="45% Safe"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Specification Chips Row (Navara 3-pill frosted glass style) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="⚓ 2,400 HP"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="🛟 850 Buoys"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="📡 AIS Radar"
                            android:textColor="@color/navara_text_title"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Glowing Turquoise Action Pill Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickStartVoyage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_navara_neon_button"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="LAUNCH SAFE RIVER JOURNEY"
                        android:textAllCaps="false"
                        android:textColor="@color/navara_text_dark"
                        android:textSize="14sp"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- 4. FLOATING ADVISORY CARD (Navara Frosted Glass Alert)         -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Meghna Confluence: Moderate cross-currents. Check weather-weighted routing."
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnAlertDismiss"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="Dismiss"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnAlertAction"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_navara_neon_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="View Safe Route"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- 5. SECTION TITLE: RIVER TRANSIT SERVICES                      -->
            <!-- ============================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01"
                android:text="River Transit Services"
                android:textColor="@color/navara_text_title"
                android:textSize="18sp" />

            <!-- ============================================================= -->
            <!-- 6. 2-COLUMN BENTO GRID OF DARK GLASS CARDS                    -->
            <!-- ============================================================= -->
            <!-- Row 1: Vessel Check & Safe Route -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: Vessel Check -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVesselCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🚢"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_vessel_check"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="QR scan &amp; safe capacity"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Safe Route -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafeRoute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🗺️"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_safe_route"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Weather-weighted map"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Family Tracker & Overload Report -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 3: Family Tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFamilyTracker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="📍"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_family_tracker"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Live GPS telemetry stream"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Overload Report -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOverloadReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="⚠️"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_overload_report"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Photo evidence upload"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 3: Offline SOS Beacon & Emergency Guides -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 5: Offline SOS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOfflineSos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#80EF4444"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🚨"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_offline_sos"
                            android:textColor="#F87171"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="P2P mesh radar beacon"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 6: Safety Guides -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafetyGuides"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_navara_chip"
                            android:gravity="center"
                            android:text="🛟"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/nav_safety_guides"
                            android:textColor="@color/navara_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CPR &amp; rescue directory"
                            android:textColor="@color/navara_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 4: Port Authority Dashboard Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#CC071B20"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/navara_neon_cyan"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_navara_chip"
                        android:gravity="center"
                        android:text="🛡️"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Port Authority Dashboard"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="BIWTA Command metrics, hotspots &amp; storm broadcast"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="➔"
                        android:textColor="@color/navara_neon_cyan"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. Academic Syllabus Diagnostics Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenLifecycleLab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="🧪 Lifecycle Lab"
                    android:textColor="@color/navara_text_subtitle"
                    android:textSize="12sp"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBottomLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="🚪 Logout"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#66FF6B6B"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
