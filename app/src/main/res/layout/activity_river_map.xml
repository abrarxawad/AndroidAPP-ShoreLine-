<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: OpenStreetMap (osmdroid) - Luxury Maritime River Route Map (Navara Glassmorphic Theme) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navara_bg_base">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- osmdroid MapView (Full Bleed Waterway Surface) -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hidden / Integrated Toolbar for BaseActivity Compatibility -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar"
            android:visibility="gone" />

        <!-- ============================================================= -->
        <!-- TOP FLOATING PILL BAR (Back Pill + Weather Pill + Title Pill) -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- Back Button Pill (<) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/navara_glass_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/navara_glass_border"
                app:strokeWidth="1.2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="❮"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="18sp" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Floating Weather Pill (+28° ☀️ River Calm) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_navara_glass_card"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="+28°"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="☀️ Calm"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- BOTTOM FLOATING GLASS CARD (Screen 2 Translucent Glass Style) -->
        <!-- ============================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/navara_glass_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/navara_glass_border"
            app:strokeWidth="1.4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Row: Route Title & Algorithm Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMapRouteTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/navara_text_title"
                        android:textSize="17sp"
                        tools:text="Dhaka ➔ Barisal (Safe Channel)" />

                    <TextView
                        android:id="@+id/tvMapAlgoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_safe"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/status_safe_text"
                        android:textSize="11sp"
                        tools:text="DIJKSTRA" />
                </LinearLayout>

                <!-- Waterway Stats (Distance & Travel Time) -->
                <TextView
                    android:id="@+id/tvMapStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/navara_neon_cyan"
                    android:textSize="13sp"
                    tools:text="Waterway Distance: 140.0 km | Est. Steamer Time: 330 mins (~5.5 hrs)" />

                <!-- Weather & Condition Notice -->
                <TextView
                    android:id="@+id/tvMapWeatherNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/navara_mint"
                    android:textSize="12sp"
                    tools:text="✓ River weather normal. All channels open for navigation." />

                <!-- Facility Chips Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_navara_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="🛡️ BIWTA Desk"
                        android:textColor="@color/navara_text_title"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_navara_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="🛟 Lifejackets"
                        android:textColor="@color/navara_text_title"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_navara_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="🏥 First Aid"
                        android:textColor="@color/navara_text_title"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
