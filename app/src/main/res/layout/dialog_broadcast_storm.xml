<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Material Dialog for BIWTA Storm Warning Signal Broadcast (Navara Theme) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_navara_glass_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_dialog_broadcast_title"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/navara_text_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/admin_dialog_broadcast_desc"
        android:textSize="12sp"
        android:textColor="@color/navara_text_subtitle" />

    <!-- Signal Level Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSignalLevel"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        android:hint="@string/admin_dialog_signal_label">

        <AutoCompleteTextView
            android:id="@+id/actvSignalLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/navara_text_title"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Affected River Sector Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRiverBasin"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        android:hint="@string/admin_dialog_zone_label">

        <AutoCompleteTextView
            android:id="@+id/actvRiverBasin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/navara_text_title"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Advisory Body Message -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAdvisoryBody"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/navara_neon_cyan"
        app:hintTextColor="@color/navara_neon_cyan"
        android:hint="@string/admin_dialog_instruction_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdvisoryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/navara_text_title"
            android:inputType="textMultiLine"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Checkbox for Local Test Broadcast -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbLocalNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/admin_dialog_test_device_check"
        android:textColor="@color/navara_text_title"
        android:textSize="12sp" />

</LinearLayout>
