<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Multi-View-Type RecyclerView - Standard Route Waypoint Step (Navara Theme) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Timeline indicator -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepIndex"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_safe"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="@color/status_safe_text"
            android:textSize="12sp"
            tools:text="1" />

        <View
            android:id="@+id/lineStepConnector"
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:background="#3300E5FF" />
    </LinearLayout>

    <!-- Ghat & Step Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepGhatName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/navara_text_title"
            android:textSize="14sp"
            tools:text="Chandpur (Molhead Ghat)" />

        <TextView
            android:id="@+id/tvStepRiverDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/navara_text_subtitle"
            android:textSize="11sp"
            tools:text="River: Padma-Meghna Confluence | Lat: 23.2321, Lon: 90.6473" />

        <TextView
            android:id="@+id/tvStepSegmentDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/navara_neon_cyan"
            android:textSize="11sp"
            tools:text="Segment: 65.0 km (~150 mins) via Sheltered Inland Channel" />
    </LinearLayout>
</LinearLayout>
