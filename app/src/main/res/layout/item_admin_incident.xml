<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView 4 Item - SOS Inbox & Admin Incident Log Card -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardIncident"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/surface_card_border"
    app:cardBackgroundColor="@color/surface_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Top Header Row: Status Chip on Left, Time & Menu on Right (Prevents Overlap) -->
        <LinearLayout
            android:id="@+id/headerTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Status Chip (Active / Acknowledged / Resolved) -->
            <TextView
                android:id="@+id/tvIncidentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_flagged"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🚨 ACTIVE MAYDAY"
                android:textColor="@color/status_danger_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Flexible Space -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Timestamp (Clearly visible, never overlaps) -->
            <TextView
                android:id="@+id/tvIncidentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                tools:text="10 mins ago" />

            <!-- Context Popup Menu Button (3 dots) -->
            <ImageButton
                android:id="@+id/btnIncidentMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Incident Actions"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Vessel Name & Sender -->
        <TextView
            android:id="@+id/tvVesselName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerTopRow"
            tools:text="MV Meghna Rani • Capt. Jamal" />

        <!-- Emergency Nature Description -->
        <TextView
            android:id="@+id/tvEmergencyNature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/status_danger_red"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVesselName"
            tools:text="⚠️ Nature: Capsizing / Rapid Inflow of River Water" />

        <!-- Mesh Hop Badge & Coordinates Row -->
        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmergencyNature">

            <!-- Hop Count Mesh Badge (Clearly visible badge) -->
            <TextView
                android:id="@+id/tvHopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_safe"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="📡 Hop 1/3 (Relayed)"
                android:textColor="@color/primary_maritime"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Location Coordinates -->
            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="📍 GPS: 23.2321° N, 90.6473° E" />
        </LinearLayout>

        <!-- Action Row -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/metaRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallVessel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="48dp"
                android:text="📞 Call Boat"
                android:textColor="@color/primary_maritime"
                android:textSize="12sp"
                app:strokeColor="@color/primary_maritime" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOnMap"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/primary_maritime"
                android:text="🗺️ Map Pin"
                android:textColor="@color/surface_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Swipe Hint Caption -->
        <TextView
            android:id="@+id/tvSwipeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="⇄ Swipe left to Resolve • Swipe right to Acknowledge • Long-press for details"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/actionRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

