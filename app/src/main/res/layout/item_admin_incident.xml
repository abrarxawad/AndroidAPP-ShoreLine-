<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: RecyclerView 4 Item - SOS Inbox & Admin Incident Log Card (Navara Glassmorphism) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardIncident"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/navara_glass_border"
    app:cardBackgroundColor="@color/navara_glass_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Header Row: Status Chip on Left, Time & Menu on Right -->
        <LinearLayout
            android:id="@+id/headerTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Status Chip -->
            <TextView
                android:id="@+id/tvIncidentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_flagged"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/admin_incident_active_badge"
                android:textColor="@color/status_danger_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvIncidentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/navara_text_subtitle"
                android:textSize="12sp"
                tools:text="10 mins ago" />

            <!-- Context Popup Menu Button (3 dots) -->
            <ImageButton
                android:id="@+id/btnIncidentMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Incident Actions"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/navara_text_subtitle" />
        </LinearLayout>

        <!-- Vessel Name & Sender -->
        <TextView
            android:id="@+id/tvVesselName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/navara_text_title"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerTopRow"
            tools:text="MV Meghna Rani • Capt. Jamal" />

        <!-- Emergency Nature Description -->
        <TextView
            android:id="@+id/tvEmergencyNature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/status_danger_red"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVesselName"
            tools:text="⚠️ Nature: Capsizing / Rapid Inflow of River Water" />

        <!-- Mesh Hop Badge & Coordinates Row -->
        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmergencyNature">

            <TextView
                android:id="@+id/tvHopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_navara_chip"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="📡 Hop 1/3 (Relayed)"
                android:textColor="@color/navara_neon_cyan"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/navara_text_subtitle"
                android:textSize="12sp"
                tools:text="📍 GPS: 23.2321° N, 90.6473° E" />
        </LinearLayout>

        <!-- Action Row -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/metaRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallVessel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_navara_glass_card"
                android:fontFamily="sans-serif-bold"
                android:minHeight="44dp"
                android:text="@string/admin_incident_call_btn"
                android:textAllCaps="false"
                android:textColor="@color/navara_text_title"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOnMap"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_navara_neon_button"
                android:fontFamily="sans-serif-black"
                android:minHeight="44dp"
                android:text="@string/admin_incident_map_btn"
                android:textAllCaps="false"
                android:textColor="@color/navara_text_dark"
                android:textSize="12sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Swipe Hint Caption -->
        <TextView
            android:id="@+id/tvSwipeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/admin_incident_swipe_hint"
            android:textColor="@color/navara_text_muted"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/actionRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
