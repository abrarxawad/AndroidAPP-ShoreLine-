<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: XML Layout - Safe River Route Planner with Route Weather (Navara Yacht Helm Glassmorphic Theme) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed Full-Screen Yacht Cockpit Night Background Layer -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Yacht Helm Navigation Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_yacht_night_helm" />

    <!-- Dark Aquatic Frosted Glass Tint for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navara_scrim_gradient" />

    <!-- Main Foreground Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reusable Glass Toolbar -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/layout_toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Card 1: Origin & Destination River Ports -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/route_select_header"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <!-- Origin Terminal -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/terminal_weather_origin"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerOrigin"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_spinner_glass"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <!-- Destination Terminal -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/terminal_weather_destination"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerDestination"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_spinner_glass"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Departure Time & Average Vessel Speed Controls -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/departure_schedule_header"
                            android:textColor="@color/navara_text_title"
                            android:textSize="15sp" />

                        <!-- Departure Time Picker Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickDepartureTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="🕒 Departure: Today 14:00 (Change Time)"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="13sp"
                            app:cornerRadius="25dp"
                            app:strokeColor="@color/navara_neon_cyan"
                            app:strokeWidth="1.2dp" />

                        <!-- Vessel Speed Controls -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvVesselSpeedLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="Launch Speed: 25 km/h"
                                android:textColor="@color/navara_text_title"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSpeedDecrease"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:fontFamily="sans-serif-black"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:text="-"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="18sp"
                                app:cornerRadius="22dp"
                                app:strokeColor="@color/navara_neon_cyan"
                                app:strokeWidth="1.2dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSpeedIncrease"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-black"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textColor="@color/navara_neon_cyan"
                                android:textSize="18sp"
                                app:cornerRadius="22dp"
                                app:strokeColor="@color/navara_neon_cyan"
                                app:strokeWidth="1.2dp" />
                        </LinearLayout>

                        <!-- Estimated Arrival Time Display -->
                        <TextView
                            android:id="@+id/tvEstimatedArrival"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="12sp"
                            tools:text="⚓ Estimated Destination Arrival: Today 19:30 (~5.5 hrs voyage)" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/progressBarWeather"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/navara_neon_cyan"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Card 3: Recommendation Banner (Go / Be Careful / Delay) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/status_safe_green"
                    app:strokeWidth="1.8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvRecommendationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/status_safe_text"
                            android:textSize="18sp"
                            tools:text="✓ GO (যাত্রা নিরাপদ)" />

                        <TextView
                            android:id="@+id/tvRecommendationDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp"
                            tools:text="All route checkpoints report calm waters and favorable river sailing conditions." />

                        <TextView
                            android:id="@+id/tvRouteComparison"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/navara_text_subtitle"
                            android:textSize="11sp"
                            tools:text="Standard waterway route is optimal and maintains low weather risk." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Origin Terminal Weather Card -->
                <include
                    android:id="@+id/cardOriginWeather"
                    layout="@layout/layout_terminal_weather_card" />

                <!-- Card 5: Destination Terminal Weather Card -->
                <include
                    android:id="@+id/cardDestinationWeather"
                    layout="@layout/layout_terminal_weather_card" />

                <!-- Card 6: Optional Current Location Weather Card -->
                <include
                    android:id="@+id/cardCurrentLocationWeather"
                    layout="@layout/layout_terminal_weather_card"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Card 7: Route Metrics & Map Action -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvRouteSummaryHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/navara_text_title"
                            android:textSize="16sp"
                            tools:text="Dhaka ➔ Barisal (Dijkstra)" />

                        <TextView
                            android:id="@+id/tvRouteMetrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="13sp"
                            tools:text="Distance: 140.0 km | Est. Travel Time: 336 mins (~5.6 hrs)" />

                        <TextView
                            android:id="@+id/tvRouteWeatherNotice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/navara_mint"
                            android:textSize="12sp"
                            tools:text="✓ Weather-weighted Dijkstra route computed." />

                        <!-- High Visibility Glowing Pill Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenRiverMap"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/navara_neon_cyan"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/btn_open_river_map"
                            android:textColor="#00141D"
                            android:textSize="14sp"
                            app:cornerRadius="26dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 8: Intermediate Waypoints Weather Section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Worst Point on Route Summary Line -->
                        <TextView
                            android:id="@+id/tvWorstPointSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="#FF6B6B"
                            android:textSize="12sp"
                            tools:text="⚠️ Worst point on route: Chandpur Confluence (Gust: 48 km/h • Risk: CAUTION)" />

                        <!-- Expand/Collapse Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleWaypoints"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/toggle_waypoints_show"
                            android:textColor="@color/navara_neon_cyan"
                            android:textSize="12sp"
                            app:cornerRadius="24dp"
                            app:strokeColor="@color/navara_glass_border"
                            app:strokeWidth="1.2dp" />

                        <!-- RecyclerView for intermediate nodes -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRouteNodesWeather"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone"
                            tools:listitem="@layout/item_route_node_weather"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 9: Evaluator Demo Storm Toggle -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/navara_glass_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/navara_glass_border"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/storm_simulate_label"
                            android:textColor="@color/navara_text_title"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchStormSimulation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/navara_neon_cyan"
                            app:trackTint="#4000E5FF" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
