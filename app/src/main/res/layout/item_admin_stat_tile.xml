<?xml version="1.0" encoding="utf-8"?>
<!-- SYLLABUS: Reusable Card Layout for GridLayoutManager Admin Command Overview (Navara Glassmorphism) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStatTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/navara_glass_border"
    app:cardBackgroundColor="@color/navara_glass_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_navara_chip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivTileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_sos" />
        </FrameLayout>

        <!-- Big Stat Metric Value -->
        <TextView
            android:id="@+id/tvStatValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/navara_text_title"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintTop_toTopOf="@id/iconContainer"
            tools:text="3" />

        <!-- Stat Title -->
        <TextView
            android:id="@+id/tvStatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/navara_text_title"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/iconContainer"
            tools:text="Active SOS Signals" />

        <!-- Subtitle / Status note -->
        <TextView
            android:id="@+id/tvStatSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/navara_text_subtitle"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tvStatTitle"
            tools:text="Requires immediate dispatch" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
