<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using MaterialComponents Dark Luxury Yacht Theme -->
    <style name="Theme.ShoreLine" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/navara_neon_cyan</item>
        <item name="colorPrimaryVariant">@color/navara_bg_base</item>
        <item name="colorOnPrimary">@color/navara_text_dark</item>

        <!-- Secondary brand color (Safety Alert Orange / Cyan Accent) -->
        <item name="colorSecondary">@color/navara_neon_cyan</item>
        <item name="colorSecondaryVariant">@color/navara_mint</item>
        <item name="colorOnSecondary">@color/navara_text_dark</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/navara_bg_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Canvas Background -->
        <item name="android:windowBackground">@color/navara_bg_base</item>
        <item name="android:colorBackground">@color/navara_bg_base</item>

        <!-- Typography / High Contrast Theme Colors -->
        <item name="android:textColorPrimary">@color/navara_text_title</item>
        <item name="android:textColorSecondary">@color/navara_text_subtitle</item>
        <item name="android:editTextColor">@color/navara_text_title</item>
        <item name="colorSurface">@color/navara_glass_surface</item>
        <item name="colorOnSurface">@color/navara_text_title</item>

        <!-- Default font family -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Fullscreen / Custom Toolbar Theme -->
    <style name="Theme.ShoreLine.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Button Styles conforming to 48dp minimum touch target -->
    <style name="Widget.ShoreLine.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="backgroundTint">@color/navara_neon_cyan</item>
        <item name="android:textColor">@color/navara_text_dark</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ShoreLine.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="backgroundTint">@color/secondary_safety_orange</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ShoreLine.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="strokeColor">@color/navara_neon_cyan</item>
        <item name="strokeWidth">@dimen/stroke_width_active</item>
        <item name="android:textColor">@color/navara_neon_cyan</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
    </style>

    <!-- MaterialCardView Custom Style: Yacht Glassmorphic Surface -->
    <style name="Widget.ShoreLine.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/navara_glass_border</item>
        <item name="strokeWidth">@dimen/stroke_width_standard</item>
        <item name="cardBackgroundColor">@color/navara_glass_surface</item>
    </style>
</resources>
