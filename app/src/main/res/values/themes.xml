<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SYLLABUS: Themes and Styles (Material Design, light theme, high contrast) -->
    <!-- Base application theme using MaterialComponents -->
    <style name="Theme.ShoreLine" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_maritime</item>
        <item name="colorPrimaryVariant">@color/primary_variant_navy</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary brand color (Safety Alert Orange) -->
        <item name="colorSecondary">@color/secondary_safety_orange</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_amber</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_variant_navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Canvas Background -->
        <item name="android:windowBackground">@color/bg_light_canvas</item>
        <item name="android:colorBackground">@color/bg_light_canvas</item>

        <!-- Default font family -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Fullscreen / Custom Toolbar Theme -->
    <style name="Theme.ShoreLine.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Button Styles conforming to 48dp minimum touch target -->
    <style name="Widget.ShoreLine.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="backgroundTint">@color/primary_maritime</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ShoreLine.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="backgroundTint">@color/secondary_safety_orange</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ShoreLine.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="strokeColor">@color/primary_maritime</item>
        <item name="strokeWidth">@dimen/stroke_width_active</item>
        <item name="android:textColor">@color/primary_maritime</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
    </style>

    <!-- MaterialCardView Custom Style -->
    <style name="Widget.ShoreLine.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/surface_card_border</item>
        <item name="strokeWidth">@dimen/stroke_width_standard</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>
</resources>
